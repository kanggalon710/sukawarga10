# Nama yang tampil ke warga TIDAK diambil dari sini, melainkan dari
# app_settings (menu Pengaturan > Info RW > Identitas Aplikasi).
# APP_NAME hanya dipakai Laravel untuk hal internal seperti pengirim email.
APP_NAME="Kampung Paru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
# Produksi: https://paru.jabnet.id (rencana pindah ke desa.jabnet.id).
# Link di pesan WhatsApp TIDAK dari sini, melainkan dari setting `alamat_portal`.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal memakai SQLite; produksi memakai MySQL (jabnet_rw10).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jabnet_rw10
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi (HTTPS).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@paru.jabnet.id"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway WhatsApp (MPWA).
# API key & nomor sender TIDAK disimpan di sini - diisi lewat menu
# Pengaturan > WhatsApp API dan tersimpan di tabel app_settings.
# Baris ini hanya untuk menimpa base URL bila gateway pindah.
# MPWA_API_URL=https://mpwa.jabnet.id
